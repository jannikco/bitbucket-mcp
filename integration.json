              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            },
            "state": {
              "type": "string",
              "enum": [
                "OPEN",
                "MERGED",
                "DECLINED",
                "SUPERSEDED"
              ]
            },
            "pagelen": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "required": [
            "workspace",
            "repo_slug"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "path": [
